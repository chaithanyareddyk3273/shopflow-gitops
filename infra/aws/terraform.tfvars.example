# Copy to terraform.tfvars (which is git-ignored) and adjust.
region             = "us-east-1"
cluster_name       = "shopflow"
kubernetes_version = "1.35"

# Your public IP, so only you can reach the Kubernetes API: curl -s https://checkip.amazonaws.com
api_allowed_cidrs = ["203.0.113.7/32"]

# SPOT is ~60-70% cheaper; fine for a demo
node_capacity_type  = "SPOT"
node_instance_types = ["t3.medium", "t3a.medium"]

monthly_budget_usd = 20
budget_alert_email = "you@example.com"
